# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX=your-pinecone-index
PINECONE_HOST=your-pinecone-host

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# GitHub Configuration
GITHUB_TOKEN=your-github-token-here

# LinkedIn Configuration (if using API)
LINKEDIN_EMAIL=your-linkedin-email
LINKEDIN_PASSWORD=your-linkedin-password

# Proxycurl API (for LinkedIn profile data)
# PROXYCURL_API_KEY=your-proxycurl-api-key

# Indeed Configuration
INDEED_USE_RSS_FEED=true
INDEED_ENABLE_PUPPETEER=true
INDEED_MAX_RETRIES=2

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-oauth2-key
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-oauth2-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_REGION_NAME=your-aws-region
AWS_STORAGE_BUCKET_NAME=your-aws-bucket-name

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4:latest

# Django settings
DJANGO_SECRET_KEY=your-django-secret-key
DEBUG=True
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
DB_NAME=searchagent
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis settings
REDIS_URL=redis://localhost:6379/0

# Email settings (for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Scraping settings
SCRAPING_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
GROK_API_KEY=your-grok-api-key
GROK_API_KEY_2=your-grok-api-key-2
MODEL=grok-2-1212
GOOGLE_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=your-google-api-key
SERPAPI_API_KEY=your-serpapi-api-key
BRAVE_WEBSEARCH_API_KEY=your-brave-websearch-api-key
BRAVE_AIDATA_API_KEY=your-brave-aidata-api-key

# Search Providers
SEARCH_PROVIDER=brave  # Options: duckduckgo, brave, google
GOOGLE_CSE_ID=your-google-cse-id

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SerpAPI (for job search)
SERPAPI_KEY=your-serpapi-key 